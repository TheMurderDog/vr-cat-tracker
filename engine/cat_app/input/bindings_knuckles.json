{
  "action_manifest_version": 0,
  "controller_type": "knuckles",
  "name": "Cat Tracker app",
  "description": "Grip grabs the wrist widget; the thumbstick resizes it while you hold it",
  "bindings": {
    "/actions/catapp": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/catapp/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/catapp/in/resize"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/catapp/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/catapp/in/resize"
            }
          }
        }
      ]
    }
  }
}