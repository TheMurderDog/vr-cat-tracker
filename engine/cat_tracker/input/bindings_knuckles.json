{
  "action_manifest_version": 0,
  "controller_type": "knuckles",
  "name": "Cat tracker",
  "description": "Both controllers buzz when the cat is underfoot; the thumbsticks are only read, to tell when VRChat moves you",
  "bindings": {
    "/actions/cat": {
      "haptics": [
        {
          "output": "/actions/cat/out/buzz",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/cat/out/buzz",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cat/in/move"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cat/in/move"
            }
          }
        }
      ]
    }
  }
}
