{
  "action_manifest_version": 0,
  "controller_type": "oculus_touch",
  "name": "Cat tracker",
  "description": "Both controllers buzz when the cat is underfoot; the thumbsticks and buttons are only read, to tell when you move in VRChat",
  "bindings": {
    "/actions/cat": {
      "haptics": [
        {
          "output": "/actions/cat/out/buzz",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/cat/out/buzz",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cat/in/move"
            },
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/cat/in/move"
            },
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/cat/in/press"
            }
          }
        }
      ]
    }
  }
}
